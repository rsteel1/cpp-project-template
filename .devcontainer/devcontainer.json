{
  "name": "C++ Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "remoteUser": "root",

  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "GIT_SSH_COMMAND": "ssh -o 'IgnoreUnknown UseKeychain'",
    "HOST_HOME": "${localEnv:HOME}",
    "XDG_CACHE_HOME": "/root/cache"
  },

  // Copies ~/.zshrc on Mac/Linux/WSL; falls back to .zshrc.baseline on Windows
  "initializeCommand": "bash .devcontainer/init-zshrc.sh",

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.zshrc.local,target=/root/.zshrc,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/root/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig.host,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly"
  ],

  // Required for sanitisers and ptrace-based debuggers
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],

  // Mount the workspace into the container
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // VSCode extensions installed automatically inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        // Language support
        "llvm-vs-code-extensions.vscode-clangd",   // clangd LSP (autocomplete, go-to-def, etc.)
        "BazelBuild.vscode-bazel",                  // Bazel integration
        // Testing
        "matepek.vscode-catch2-test-adapter",       // Test Mate C++ (GTest/Catch2/doctest runner)
        "hbenl.vscode-test-explorer",               // Test explorer sidebar
        // Debugging
        "vadimcn.vscode-lldb",                      // LLDB debugger (works with clang)
        // Code quality
        "xaver.clang-format",                       // clang-format on save
        "notskm.clang-tidy",                        // clang-tidy linting
        "mine.cpplint"                              // cpplint style checker
      ],
      "settings": {
        // Use clangd instead of the default IntelliSense engine
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.path": "/usr/bin/clangd",
        "clangd.arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=iwyu"
        ],
        // Format and fixups on save
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.trimFinalNewlines": true,
        "[cpp]": {
          "editor.defaultFormatter": "xaver.clang-format",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        // Terminal defaults
        "terminal.integrated.defaultProfile.linux": "zsh",
        // cpplint
        "cpplint.cpplintPath": "/usr/local/bin/cpplint",
        "cpplint.linelength": "80",
        "cpplint.extensions": ["cpp", "h"],
        "cpplint.headers": ["h"],
        "cpplint.verbose": 1
      }
    }
  },

  // Post-create: configure git identity, build all targets, generate compile_commands.json for clangd, wire caveman hooks
  "postCreateCommand": "git config --global user.name \"$(git config -f /root/.gitconfig.host user.name)\" && git config --global user.email \"$(git config -f /root/.gitconfig.host user.email)\" && bazel build //... && bazel-compile-commands //... && bash .devcontainer/install-caveman.sh"
}
