{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "bazel build //...",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "bazel test //...",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run Benchmarks",
      "type": "shell",
      "command": "bazel run //benchmarks:benchmarks",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Build (ASan)",
      "type": "shell",
      "command": "bazel build //... --config=asan",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run Tests (ASan)",
      "type": "shell",
      "command": "bazel test //... --config=asan",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Build (TSan)",
      "type": "shell",
      "command": "bazel build //... --config=tsan",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run Tests (TSan)",
      "type": "shell",
      "command": "bazel test //... --config=tsan",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Refresh compile_commands.json",
      "type": "shell",
      "command": "bazel-compile-commands //...",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "bazel clean",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "IWYU: Check (dry run)",
      "type": "shell",
      "command": "iwyu_tool.py -p build 2>&1 | tee /tmp/iwyu.out && echo '\\nDone. Run \"IWYU: Fix\" to apply.'",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "IWYU: Fix",
      "type": "shell",
      "command": "iwyu_tool.py -p build 2>&1 | fix_includes.py && echo '\\nIncludes updated. Review changes with git diff.'",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
